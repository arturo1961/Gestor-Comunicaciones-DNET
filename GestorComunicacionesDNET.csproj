<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GestorComunicacionesDNET</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>annotations</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GestorComunicacionesDNET</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="GestorComunicacionesDNET.Datos.contactos.json" />
    <None Remove="GestorComunicacionesDNET.Datos.envios.json" />
    <EmbeddedResource Include="GestorComunicacionesDNET.Datos.contactos.json" LogicalName="GestorComunicacionesDNET.Datos.contactos.json" />
    <EmbeddedResource Include="GestorComunicacionesDNET.Datos.envios.json" LogicalName="GestorComunicacionesDNET.Datos.envios.json" />
  </ItemGroup>
</Project>
